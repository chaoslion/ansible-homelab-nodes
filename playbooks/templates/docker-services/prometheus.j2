{%- macro notification_template_title(titleLimit=150) -%}
{%- set defaultCutoff = [titleLimit - 10, 0] | max -%}
{{ "{{{{- $titleLimit := {0} -}}}}".format(titleLimit) }}
{{ "{{{{- $baseCutoff := {0} -}}}}".format(defaultCutoff) }}
{%- raw %}
{{- /* Field Normalization */ -}}
{{- $groupLabels := or .GroupLabels .groupLabels -}}
{{- $alerts := or .Alerts .alerts -}}

{{- /* Extract Labels */ -}}
{{- $alertname := or (index $groupLabels "alertname") "Alert" -}}
{{- $job := index $groupLabels "job" -}}

{{- /* Compose Base Title */ -}}
{{- $base := $alertname -}}
{{- if $job -}}
  {{- $base = printf "%s (%s)" $alertname $job -}}
{{- end -}}

{{- /* Calculate Alert Count Suffix */ -}}
{{- $countSuffix := "" -}}
{{- $total := len $alerts -}}
{{- if gt $total 100 -}}
  {{- $countSuffix = " [99+]" -}}
{{- else if gt $total 1 -}}
  {{- $countSuffix = printf " [%d]" $total -}}
{{- end -}}

{{- /* Fit Base + Suffix inside $titleLimit */ -}}
{{- $title := printf "%s%s" $base $countSuffix -}}
{{- if gt (len $title) $titleLimit -}}
  {{- $title = printf (printf "%%.%ds...%%s" $baseCutoff) $base $countSuffix -}}
{{- end -}}

{{ $title }}
{%- endraw %}
{%- endmacro -%}

{%- macro notification_template_message(maxBudget=1000, descLimit=140) -%}
{{ "{{{{- $maxBudget := {0} -}}}}".format(maxBudget) }}
{{ "{{{{- $descLimit := {0} -}}}}".format(descLimit) }}
{%- raw %}
{{- $truncationMarker := "...\n" -}}

{{- /* Field Normalization */ -}}
{{- $alerts := or .Alerts .alerts -}}

{{- /* Description Header */ -}}
{{- $first := index $alerts 0 -}}
{{- $firstAnns := or $first.Annotations $first.annotations -}}
{{- $rawDesc := or (index $firstAnns "description") "Alert Details" -}}
{{- $desc := printf (printf "%%.%ds" $descLimit) $rawDesc -}}
{{- if gt (len $rawDesc) $descLimit -}}{{- $desc = printf "%s..." $desc -}}{{- end -}}

{{- /* Build string buffer and test total output size directly */ -}}
{{- $renderedLines := "" -}}
{{- $truncated := false -}}

{{- range $a := $alerts -}}
  {{- $anns := or $a.Annotations $a.annotations -}}
  {{- $summary := or (index $anns "summary") "firing" -}}
  {{- $line := printf "%s\n" $summary -}}

  {{- /* Test candidate total length directly against $maxBudget */ -}}
  {{- $candidate := printf "%s\n\n%s%s%s" $desc $renderedLines $line $truncationMarker -}}
  {{- if and (not $truncated) (le (len $candidate) $maxBudget) -}}
    {{- $renderedLines = printf "%s%s" $renderedLines $line -}}
  {{- else -}}
    {{- $truncated = true -}}
  {{- end -}}
{{- end -}}

{{- if $truncated -}}
  {{- $renderedLines = printf "%s%s" $renderedLines $truncationMarker -}}
{{- end -}}

{{ $desc }}

{{ $renderedLines }}
{%- endraw %}
{%- endmacro -%}


{%- macro target_static_configs(targets) -%}
{% for target in targets %}
  - targets: ["{{ target.address }}"]
    labels:
      __source_host: "{{ target.source_host }}"
{% endfor %}
{%- endmacro %}

{%- macro instance_relabel_config() %}
  - source_labels: [__source_host]
    regex: "(.+)"
    target_label: instance
{%- endmacro %}

{%- macro blackbox_probe_relabel_configs(exporter_address, address_replacement=None) %}
  - source_labels: ["__address__"]
    target_label: __param_target
{% if address_replacement %}
    replacement: "{{ address_replacement }}"
{% endif %}
  - source_labels: [__param_target]
    target_label: instance
  - target_label: __address__
    replacement: "{{ exporter_address }}"
{%- endmacro %}

{% macro scrapes() %}
{%- set result = {"scrape_configs": []} %}
{%- for item in q("ansible.builtin.fileglob", role_path ~ "/templates/scrapes/*.yml.j2") | sort %}
{%- set rendered = (lookup("ansible.builtin.template", item) or "") | trim %}
{%- if rendered %}
{%- set _ = result.scrape_configs.append({"job_name": item | basename | replace(".yml.j2", "") | replace("-", "/")} | ansible.builtin.combine(rendered | ansible.builtin.from_yaml, recursive=true)) %}
{%- endif %}
{%- endfor %}
{{- result | homelab.nodes.to_yaml | trim }}
{% endmacro %}

{% macro rules_common_jobs_down(jobs) %}
{%- set clauses = [] %}
{%- for job_name in jobs %}
{%- set _ = clauses.append('absent(up{job="' ~ job_name ~ '"})') %}
{%- endfor %}
alert: "CommonJobDown"
expr: '{{ clauses | join(" or ") }}'
for: "15m"
labels:
  severity: critical
annotations:
  description: "Scrape job has no reachable targets."
  summary: "{% raw %}{{ $labels.job }}{% endraw %}"
{% endmacro %}

{% macro rules(watch=[]) %}
{%- set groups = {} %}
{%- for item in q("ansible.builtin.fileglob", role_path ~ "/files/rules/*.yml") | sort %}
{%- set group_name = item | basename | replace(".yml", "") %}
{%- set _ = groups.update({group_name: lookup("ansible.builtin.file", item) | ansible.builtin.from_yaml}) %}
{%- endfor %}
{%- set group_common = {} %}
{%- if watch %}
{%- set _  = group_common.update({"common_generated": {"rules": [rules_common_jobs_down(watch) | from_yaml]}}) -%}
{%- endif %}
{%- set config_groups = [] %}
{%- for name, group in (groups | ansible.builtin.combine(group_common, recursive=true)).items() %}
{%- set _ = config_groups.append({"name": name} | ansible.builtin.combine(group, recursive=true)) %}
{%- endfor %}
{{- {"groups": config_groups} | homelab.nodes.to_yaml | trim }}
{% endmacro %}

{% macro custom_rules() %}
{{- rules() -}}
{% endmacro %}
