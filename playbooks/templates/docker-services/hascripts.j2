{% macro supervisord_config(supervisord_configs, supervisord_logs, startup_sync=true) %}
[supervisord]
logfile=/dev/null
logfile_maxbytes=0
loglevel=info
childlogdir={{ supervisord_logs }}
strip_ansi=true

[unix_http_server]
file=/run/supervisor.sock
chmod=0777
chown=nobody:nogroup

[inet_http_server]
port=0.0.0.0:9001

[supervisorctl]
serverurl=unix:///run/supervisor.sock

[include]
files={{ supervisord_configs }}/*.conf

[rpcinterface:supervisor]
supervisor.rpcinterface_factory=supervisor.rpcinterface:make_main_rpcinterface

[program:hascripts-http]
command=/usr/local/bin/hascripts-http
environment=PYTHONDONTWRITEBYTECODE=1
startsecs=5
startretries=0
priority=999
stdout_logfile_maxbytes=1MB
stdout_logfile_backups=3
stderr_logfile_maxbytes=1MB
stderr_logfile_backups=3

[program:hascripts-sync]
command=/usr/local/bin/hascripts-sync
environment=PYTHONDONTWRITEBYTECODE=1
{% if startup_sync %}
startsecs=5
startretries=5
priority=999
{% else %}
autostart=false
{% endif %}
stdout_logfile_maxbytes=1MB
stdout_logfile_backups=3
stderr_logfile_maxbytes=1MB
stderr_logfile_backups=3
{% endmacro %}
