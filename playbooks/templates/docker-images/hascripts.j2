{% import "dockerfile-helper.j2" as helper %}

{{ helper.apt_install(["yq", "bash-completion", "vim"]) }}

{% set packages | ansible.builtin.from_yaml %}
- aiohttp
- aiohttp-jinja2
- apscheduler
- argcomplete
- gunicorn
- hass-client
- icalendar
- lmdb
- pdbpp
- plankapy
- pydantic
- pyyaml
- supervisor
{% endset %}
{{ helper.pip_install(packages) }}

RUN activate-global-python-argcomplete
RUN printf "from fancycompleter import DefaultConfig\n\nclass Config(DefaultConfig):\n\tprefer_pyrepl = False\n" > /root/.fancycompleterrc.py

COPY hascripts/hascripts /opt/homelab-hascripts
RUN pip install /opt/homelab-hascripts
